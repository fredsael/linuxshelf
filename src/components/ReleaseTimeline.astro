---
import type { Program } from "../lib/schema";
import { buildTimeline } from "../lib/timeline";
import { formatDate } from "../lib/format";

interface Props {
  program: Program;
}

const { program } = Astro.props;
const model = buildTimeline(program);

const tooltipClass = (offsetPct: number): string => {
  if (offsetPct <= 3) return " timeline-dot--start";
  if (offsetPct >= 97) return " timeline-dot--end";
  return "";
};
---

{
  model && (
    <section class="timeline" aria-labelledby="timeline-heading" data-pagefind-ignore>
      <div class="timeline-head">
        <h2 id="timeline-heading">Release timeline</h2>
        <div class="timeline-controls" role="group" aria-label="Timeline zoom">
          <button type="button" class="timeline-zoom is-active" data-zoom="year" aria-pressed="true">
            Year
          </button>
          <button type="button" class="timeline-zoom" data-zoom="month" aria-pressed="false">
            Month
          </button>
        </div>
      </div>

      <div class="timeline-scroll">
        <div
          class="timeline-track"
          aria-hidden="true"
          style={`--track-width-year: ${model.yearWidthPx}px; --track-width-month: ${model.monthWidthPx}px;`}
        >
          <div class="timeline-axis"></div>

          <div class="timeline-ticks timeline-ticks--year">
            {model.yearTicks.map((tick) => (
              <div class="timeline-tick" style={`left: ${tick.offsetPct}%;`}>
                <span>{tick.label}</span>
              </div>
            ))}
          </div>

          <div class="timeline-ticks timeline-ticks--month">
            {model.monthTicks.map((tick) => (
              <div class="timeline-tick" style={`left: ${tick.offsetPct}%;`}>
                <span>{tick.label}</span>
              </div>
            ))}
          </div>

          <div class="timeline-points">
            {model.points.map((point) => (
              <span
                class:list={[
                  "timeline-dot",
                  { "timeline-dot--marker": point.version === undefined },
                  tooltipClass(point.offsetPct).trim(),
                ]}
                style={`left: ${point.offsetPct}%; --lane: ${point.lane};`}
              >
                <span class="timeline-tip">
                  {point.version ?? point.label} · {formatDate(point.date)}
                </span>
              </span>
            ))}
          </div>
        </div>
      </div>

      <dl class="timeline-data">
        {model.points.map((point) => (
          <div>
            <dt>{point.version ?? point.label}</dt>
            <dd>{formatDate(point.date)}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<script>
  const sections = document.querySelectorAll<HTMLElement>(".timeline");
  for (const section of sections) {
    const buttons = section.querySelectorAll<HTMLButtonElement>("[data-zoom]");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const zoomed = button.dataset.zoom === "month";
        section.classList.toggle("timeline--month", zoomed);
        for (const other of buttons) {
          const active = other === button;
          other.classList.toggle("is-active", active);
          other.setAttribute("aria-pressed", String(active));
        }
      });
    }
  }
</script>

<style>
  .timeline {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    padding-top: 1.75rem;
  }

  .timeline h2 {
    font-size: 1.25rem;
    margin: 0;
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .timeline-controls {
    display: flex;
    gap: 0.35rem;
  }

  .timeline-zoom {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius, 6px);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .timeline-zoom:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .timeline-zoom.is-active {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: var(--accent);
  }

  .timeline-scroll {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .timeline-track {
    position: relative;
    min-width: 100%;
    width: var(--track-width-year);
    height: 7.5rem;
  }

  .timeline--month .timeline-track {
    width: var(--track-width-month);
  }

  .timeline-axis {
    position: absolute;
    top: 3.75rem;
    left: 0;
    right: 0;
    border-top: 1px solid var(--border);
  }

  .timeline-ticks {
    position: absolute;
    inset: 0;
  }

  .timeline-ticks--month {
    display: none;
  }

  .timeline--month .timeline-ticks--year {
    display: none;
  }

  .timeline--month .timeline-ticks--month {
    display: block;
  }

  .timeline-tick {
    position: absolute;
    top: 3.75rem;
    width: 1px;
    height: 6px;
    background: var(--border);
  }

  .timeline-ticks--month .timeline-tick {
    height: 4px;
  }

  .timeline-tick span {
    position: absolute;
    top: 9px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .timeline-tick:first-child span {
    left: 0;
    transform: none;
  }

  .timeline-points {
    position: absolute;
    inset: 0;
  }

  .timeline-dot {
    position: absolute;
    top: calc(3.75rem - var(--lane, 0) * 16px);
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .timeline-dot--marker {
    background: var(--surface-raised);
    border: 1px solid var(--text-muted);
  }

  .timeline-dot:hover {
    z-index: 3;
  }

  .timeline-tip {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface-raised);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease;
  }

  .timeline-dot--start .timeline-tip {
    left: -4px;
    transform: none;
  }

  .timeline-dot--end .timeline-tip {
    left: auto;
    right: -4px;
    transform: none;
  }

  .timeline-dot:hover .timeline-tip {
    opacity: 1;
  }

  .timeline-data {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
