---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import { loadPrograms } from "../lib/programs";

interface Props {
  id?: string;
}
const id = Astro.props.id ?? "site-search";
const inputId = `${id}-input`;
const resultsId = `${id}-results`;

const iconsDir = fileURLToPath(new URL("../../public/icons", import.meta.url));
const programIcons = Object.fromEntries(
  loadPrograms().map((program) => [
    program.slug,
    {
      svg: existsSync(join(iconsDir, `${program.slug}.svg`))
        ? `/icons/${program.slug}.svg`
        : null,
      emoji: program.icon?.trim() || "📦",
    },
  ])
);
---

<div class="search" data-search>
  <label class="visually-hidden" for={inputId}>Search programs</label>
  <div class="search-box">
    <svg
      class="search-icon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <input
      id={inputId}
      type="search"
      placeholder="Search programs…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls={resultsId}
      aria-autocomplete="list"
      data-search-input
    />
    <kbd class="search-kbd" aria-hidden="true">/</kbd>
  </div>
  <div id={resultsId} class="search-results" role="listbox" aria-label="Search results" hidden data-search-results></div>
  <script
    type="application/json"
    data-program-icons
    is:inline
    set:html={JSON.stringify(programIcons)}
  ></script>
</div>

<script>
  const initSearch = async () => {
    const roots = document.querySelectorAll<HTMLElement>("[data-search]");
    if (roots.length === 0) return;

    type PagefindResult = {
      data: () => Promise<{
        url: string;
        meta?: { title?: string };
      }>;
    };
    type PagefindModule = {
      search: (query: string) => Promise<{ results: PagefindResult[] }>;
    };

    let pagefind: PagefindModule | null = null;
    let pagefindFailed = false;

    const loadPagefind = async (): Promise<PagefindModule | null> => {
      if (pagefind) return pagefind;
      if (pagefindFailed) return null;
      try {
        const path = "/pagefind/pagefind.js";
        const mod = (await import(/* @vite-ignore */ path)) as PagefindModule;
        pagefind = mod;
        return mod;
      } catch {
        pagefindFailed = true;
        return null;
      }
    };

    const escapeHtml = (value: string) =>
      value.replace(
        /[&<>"']/g,
        (char) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[char] ?? char
      );

    type ProgramIcon = { svg: string | null; emoji: string };
    let programIcons: Record<string, ProgramIcon> = {};
    try {
      const json = document.querySelector<HTMLScriptElement>(
        "[data-program-icons]"
      )?.textContent;
      if (json) programIcons = JSON.parse(json) as Record<string, ProgramIcon>;
    } catch {
      programIcons = {};
    }

    const iconMarkup = (url: string): string => {
      const slug = /\/programs\/([^/]+)\/?$/.exec(url)?.[1];
      const icon = slug ? programIcons[slug] : undefined;
      if (icon?.svg) {
        return `<img class="search-result-icon" src="${escapeHtml(
          icon.svg
        )}" alt="" width="22" height="22" loading="lazy" />`;
      }
      return `<span class="search-result-icon search-result-icon--emoji" aria-hidden="true">${escapeHtml(
        icon?.emoji ?? "📦"
      )}</span>`;
    };

    for (const root of roots) {
      const input = root.querySelector<HTMLInputElement>("[data-search-input]");
      const panel = root.querySelector<HTMLElement>("[data-search-results]");
      if (!input || !panel) continue;

      let activeIndex = -1;
      let timer: ReturnType<typeof setTimeout> | undefined;

      const close = () => {
        panel.hidden = true;
        panel.innerHTML = "";
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
        activeIndex = -1;
      };

      const setActive = (index: number) => {
        const items = panel.querySelectorAll<HTMLAnchorElement>("a[role='option']");
        if (items.length === 0) return;
        activeIndex = (index + items.length) % items.length;
        items.forEach((item, i) => {
          const isActive = i === activeIndex;
          item.classList.toggle("is-active", isActive);
          item.setAttribute("aria-selected", String(isActive));
        });
        input.setAttribute("aria-activedescendant", items[activeIndex].id);
      };

      const runSearch = async (query: string) => {
        if (!query) {
          close();
          return;
        }
        const module = await loadPagefind();
        if (!module) {
          panel.innerHTML = `<p class="search-empty">Search is available in production builds (<code>npm run build</code>).</p>`;
          panel.hidden = false;
          input.setAttribute("aria-expanded", "true");
          return;
        }
        try {
          const search = await module.search(query);
          const results = await Promise.all(
            search.results.slice(0, 8).map((result) => result.data())
          );
          if (results.length === 0) {
            panel.innerHTML = `<p class="search-empty">No programs match “${escapeHtml(query)}”.</p>`;
          } else {
            panel.innerHTML = results
              .map(
                (result, index) => `
                  <a
                    id="${input.id}-option-${index}"
                    role="option"
                    aria-selected="false"
                    class="search-result"
                    href="${escapeHtml(result.url)}"
                  >
                    ${iconMarkup(result.url)}
                    <span class="search-result-title">${escapeHtml(
                      result.meta?.title ?? result.url
                    )}</span>
                  </a>`
              )
              .join("");
          }
          panel.hidden = false;
          input.setAttribute("aria-expanded", "true");
          activeIndex = -1;
        } catch {
          close();
        }
      };

      input.addEventListener("input", () => {
        clearTimeout(timer);
        timer = setTimeout(() => void runSearch(input.value.trim()), 120);
      });

      input.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          setActive(activeIndex + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          setActive(activeIndex - 1);
        } else if (event.key === "Enter" && activeIndex >= 0) {
          const active = panel.querySelector<HTMLAnchorElement>(
            "a[role='option'].is-active"
          );
          if (active) {
            event.preventDefault();
            window.location.href = active.href;
          }
        } else if (event.key === "Escape") {
          input.value = "";
          close();
          input.blur();
        }
      });

      document.addEventListener("click", (event) => {
        if (!root.contains(event.target as Node)) close();
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      if (
        target &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          target.tagName === "SELECT" ||
          target.isContentEditable)
      ) {
        return;
      }
      const first = document.querySelector<HTMLInputElement>("[data-search-input]");
      if (first) {
        event.preventDefault();
        first.focus();
        first.select();
      }
    });
  };

  void initSearch();
</script>

<style>
  .search {
    position: relative;
    flex: 1 1 16rem;
    max-width: 24rem;
    min-width: 0;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.7rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  input[type="search"] {
    width: 100%;
    padding: 0.55rem 2.4rem 0.55rem 2.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-family: inherit;
    font-size: 0.9rem;
  }

  input[type="search"]::placeholder {
    color: var(--text-muted);
  }

  input[type="search"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  input[type="search"]::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-kbd {
    position: absolute;
    right: 0.6rem;
    padding: 0.1em 0.45em;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .search-results {
    position: absolute;
    z-index: 30;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    max-height: 24rem;
    overflow-y: auto;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.55);
  }

  .search-results :global(.search-result) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .search-results :global(.search-result:last-child) {
    border-bottom: none;
  }

  .search-results :global(.search-result:hover),
  .search-results :global(.search-result.is-active) {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: inherit;
  }

  .search-results :global(.search-result-icon) {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    object-fit: contain;
  }

  .search-results :global(.search-result-icon--emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    line-height: 1;
  }

  .search-results :global(.search-result-title) {
    font-weight: 600;
    font-size: 0.92rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-results :global(.search-empty) {
    margin: 0;
    padding: 0.75rem 0.9rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .search-results :global(.search-empty code) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05em 0.3em;
    font-size: 0.85em;
  }

  @media (max-width: 640px) {
    .search {
      max-width: none;
      flex-basis: 100%;
    }

    .search-results {
      position: static;
      margin-top: 0.4rem;
      box-shadow: none;
    }
  }
</style>
